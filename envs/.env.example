# Copy to envs/keys.env, or split keys between envs/CHINA.env and envs/USA.env.
# All envs/*.env files load automatically; this example does not.
# Use literal dotenv values, not shell commands or ${VARIABLE} expansions.
# Names must match the provider YAML's api_key_env.
# Anthropic is optional: claude-sub -p uses this key when set; interactive mode
# follows Claude Code's key approval policy. Leave blank to use native login.
# Keys are scoped to claude-sub; do not source/export this file into your shell.
ANTHROPIC_API_KEY=
# Kimi Code Console subscription key (not a Moonshot Open Platform key).
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
# Z.ai Coding Plan key (not a standard model API key).
ZAI_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=
