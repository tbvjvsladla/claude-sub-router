# Copy to envs/keys.env, or split keys between envs/CHINA.env and envs/USA.env.
# All envs/*.env files load automatically at router startup; this example does not.
# Use literal dotenv values, not shell commands or ${VARIABLE} expansions.
# Names must match the provider YAML's api_key_env. Sonnet uses subscription login.
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
