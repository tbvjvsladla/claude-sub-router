{
  "name": "claude-sub-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loopback-only multi-provider router and isolated Claude Code launcher",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test tests/*.test.ts",
    "start": "node dist/cli.js serve",
    "test:cli": "node scripts/test-cli.mjs",
    "test:release": "node scripts/test-release.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "package:release": "npm run build && node scripts/package-release.mjs"
  },
  "files": [
    "dist",
    "config/providers",
    "config/claude-settings.json",
    "install.sh",
    "uninstall.sh",
    "env.bash",
    "scripts/run-router.sh",
    "README.md",
    "SECURITY.md",
    "envs/.env.example"
  ],
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
